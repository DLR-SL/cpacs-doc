<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:complexType name="baseType">
        <xsd:sequence>
            <xsd:element name="baseField" type="xsd:string"/>
        </xsd:sequence>
        <xsd:attribute name="externalFileName" type="xsd:string"/>
        <xsd:attribute name="externalDataDirectory" type="xsd:string"/>
    </xsd:complexType>

    <xsd:simpleType name="symmetryType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="none">
                <xsd:annotation><xsd:documentation>no symmetry</xsd:documentation></xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="x-y-plane"/>
            <xsd:enumeration value="x-z-plane"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="valueBaseType">
        <xsd:simpleContent>
            <xsd:extension base="xsd:double">
                <xsd:attribute name="unit" type="xsd:string"/>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:complexType name="measuredValueType">
        <xsd:simpleContent>
            <xsd:extension base="valueBaseType">
                <xsd:attribute name="accuracy" type="xsd:double"/>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:complexType name="wingType">
        <xsd:complexContent>
            <xsd:extension base="baseType">
                <xsd:sequence>
                    <xsd:element name="span" type="xsd:double"/>
                    <xsd:element name="mode" minOccurs="0">
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:enumeration value="inline-only"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="segment" type="xsd:string" maxOccurs="unbounded"/>
                    <xsd:any namespace="##other" processContents="lax" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>Anything from elsewhere.</xsd:documentation>
                        </xsd:annotation>
                    </xsd:any>
                    <xsd:group ref="unreadGroup"/>
                    <xsd:element name="unit" type="xsd:string" fixed="m" minOccurs="0"/>
                    <xsd:element name="ratio" minOccurs="0" default="0.5">
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:double">
                                <xsd:minInclusive value="0"/>
                                <xsd:maxInclusive value="1"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                </xsd:sequence>
                <xsd:attribute name="uID" type="xsd:ID" use="required"/>
                <xsd:attribute name="symmetry" type="symmetryType" default="none"/>
                <xsd:attribute name="externalDataDirectory" type="xsd:string" use="required"/>
                <xsd:attribute name="rating">
                    <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                            <xsd:enumeration value="draft"/>
                            <xsd:enumeration value="final"/>
                        </xsd:restriction>
                    </xsd:simpleType>
                </xsd:attribute>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

    <!-- Not read by the extractor; it is a finding, not a silent gap. -->
    <xsd:group name="unreadGroup">
        <xsd:sequence>
            <xsd:element name="fromAGroup" type="xsd:string"/>
        </xsd:sequence>
    </xsd:group>

    <xsd:complexType name="emptyType"/>

    <xsd:complexType name="choiceType">
        <xsd:sequence>
            <xsd:element name="always" type="xsd:string"/>
            <xsd:choice minOccurs="0">
                <xsd:element name="either" type="xsd:string"/>
                <xsd:sequence>
                    <xsd:element name="bothA" type="xsd:string"/>
                    <xsd:element name="bothB" type="xsd:string"/>
                </xsd:sequence>
            </xsd:choice>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="cpacs" type="wingType"/>
</xsd:schema>
